# Redis Media Caching - Environment Variables

# CloudFront Configuration (Optional - for future CDN migration)
# Set USE_CLOUDFRONT=true to enable CloudFront URLs instead of S3 signed URLs
USE_CLOUDFRONT=false

# CloudFront Distribution Domain (e.g., d111111abcdef8.cloudfront.net)
# CLOUDFRONT_DOMAIN=your-distribution.cloudfront.net

# CloudFront Key Pair ID for signed URLs
# CLOUDFRONT_KEY_PAIR_ID=your-key-pair-id

# CloudFront Private Key (base64 encoded or file path)
# CLOUDFRONT_PRIVATE_KEY=your-private-key-base64

# CloudFront URL Expiration (in seconds, default: 86400 = 24 hours)
# CLOUDFRONT_URL_EXPIRATION=86400

# Redis Configuration (should already exist in your .env)
# REDIS_URL=redis://localhost:6379
